{
  "name": "presto-functions",
  "version": "1.0.0",
  "description": "Cloud Functions pour Presto App",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "ci": "npm run build && npm test && npm run taxonomy:check",
    "ai:eval:media": "node scripts/generate_ai_eval_media.mjs",
    "ai:eval:listing": "node scripts/openai_listing_eval.mjs",
    "ai:eval:transcription": "node scripts/openai_transcription_eval.mjs",
    "ai:eval:transcription:dry": "node scripts/openai_transcription_eval.mjs --dry-run",
    "ai:eval:vision": "node scripts/openai_vision_eval.mjs",
    "ai:eval:vision:dry": "node scripts/openai_vision_eval.mjs --dry-run",
    "ai:prompt:tokens": "node scripts/openai_prompt_token_report.mjs",
    "ai:metrics:report": "node scripts/ai_metrics_report.mjs",
    "ai:metrics:trend": "node scripts/ai_metrics_trend.mjs",
    "ai:smoke:production": "node scripts/microia_production_smoke_test.mjs",
    "ai:smoke:rollback": "node scripts/remote_config_rollback_smoke.mjs",
    "taxonomy:check": "node ../tools/check_listing_taxonomy_sync.mjs",
    "marketplace:audit:collections": "node --experimental-strip-types scripts/auditFirestoreCollections.ts",
    "marketplace:seed": "node scripts/seed_marketplace_bootstrap.mjs",
    "marketplace:seed:dry-run": "node scripts/seed_marketplace_bootstrap.mjs --dry-run",
    "marketplace:seed:taxonomy": "node --experimental-strip-types scripts/seedMarketplaceTaxonomy.ts --apply",
    "marketplace:seed:taxonomy:dry-run": "node --experimental-strip-types scripts/seedMarketplaceTaxonomy.ts --dry-run",
    "marketplace:migrate:offers-to-listings:dry-run": "node scripts/migrate_offers_to_listings.mjs --dry-run",
    "marketplace:migrate:offers-to-listings": "node scripts/migrate_offers_to_listings.mjs",
    "marketplace:migrate:offers-to-listings:v2:dry-run": "node --experimental-strip-types scripts/migrateOffersToListings.ts --dry-run",
    "marketplace:migrate:offers-to-listings:v2": "node --experimental-strip-types scripts/migrateOffersToListings.ts --apply",
    "marketplace:migrate:favorites:dry-run": "node scripts/migrateFavoriteOffersToFavorites.ts --dry-run",
    "marketplace:migrate:favorites": "node scripts/migrateFavoriteOffersToFavorites.ts --apply",
    "marketplace:migrate:profiles:dry-run": "node --experimental-strip-types scripts/migrateProfilesToUsers.ts --dry-run",
    "marketplace:migrate:profiles": "node --experimental-strip-types scripts/migrateProfilesToUsers.ts --apply",
    "test:firestore:public-listings": "npx --yes firebase-tools@13 emulators:exec --config ../firebase.json --only firestore \"node scripts/test_public_listings_rules.mjs\"",
    "test:firestore:canonical-rules": "npx --yes firebase-tools@13 emulators:exec --config ../firebase.json --only firestore \"node scripts/test_canonical_marketplace_rules.mjs\"",
    "test:firestore:user-authority": "npx --yes firebase-tools@13 emulators:exec --config ../firebase.json --only firestore \"node scripts/test_user_authority_rules.mjs\"",
    "test:firestore": "npm run test:firestore:public-listings && npm run test:firestore:canonical-rules && npm run test:firestore:user-authority",
    "test:load:1000": "npx --yes firebase-tools@13 emulators:exec --config ../firebase.json --only firestore \"node scripts/load_test_1000_users.mjs\"",
    "test": "npm run build && node --test $(find lib -name '*.test.js' -print)",
    "email:audit:new-events": "node scripts/audit_new_email_events.mjs",
    "brevo:webhook:smoke": "node scripts/brevo_webhook_smoke_test.mjs",
    "stripe:checkout:e2e": "node scripts/stripe_checkout_e2e.mjs",
    "stripe:checkout:e2e:verify": "node scripts/stripe_checkout_e2e_verify.mjs",
    "messaging:backfill:mirror:dry-run": "npm run build && node scripts/backfill_conversation_mirror_fields.mjs --dry-run",
    "messaging:backfill:mirror": "npm run build && node scripts/backfill_conversation_mirror_fields.mjs",
    "offers:backfill:indexes:dry-run": "node scripts/backfill_offer_indexes.mjs --dry-run",
    "offers:backfill:indexes": "node scripts/backfill_offer_indexes.mjs",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "npm run build && firebase deploy --only functions",
    "logs": "firebase functions:log",
    "marketplace:migrate:private-contacts:dry-run": "node scripts/migrate_listing_private_contacts.mjs",
    "marketplace:migrate:private-contacts": "node scripts/migrate_listing_private_contacts.mjs --apply",
    "admin:claims:dry-run": "node scripts/migrate_admin_claims.mjs",
    "admin:claims:apply": "node scripts/migrate_admin_claims.mjs --apply",
    "admin:claims:apply:revoke": "node scripts/migrate_admin_claims.mjs --apply --revoke-tokens",
    "admin:claims:verify": "node scripts/migrate_admin_claims.mjs --verify"
  },
  "dependencies": {
    "@google-cloud/speech": "^7.5.0",
    "@google-cloud/vertexai": "^1.12.0",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "google-auth-library": "^11.0.0",
    "nodemailer": "^9.0.3",
    "openai": "^7.3.0",
    "resend": "^6.18.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^26.1.2",
    "firebase": "^12.17.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.9.16"
  }
}
