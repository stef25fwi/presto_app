{
  "name": "presto-functions",
  "version": "1.0.0",
  "description": "Cloud Functions pour Presto App",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "ci": "npm run build && npm test",
    "marketplace:audit:collections": "node --experimental-strip-types scripts/auditFirestoreCollections.ts",
    "marketplace:seed": "node scripts/seed_marketplace_bootstrap.mjs",
    "marketplace:seed:dry-run": "node scripts/seed_marketplace_bootstrap.mjs --dry-run",
    "marketplace:seed:taxonomy": "node --experimental-strip-types scripts/seedMarketplaceTaxonomy.ts --apply",
    "marketplace:seed:taxonomy:dry-run": "node --experimental-strip-types scripts/seedMarketplaceTaxonomy.ts --dry-run",
    "marketplace:migrate:offers-to-listings:dry-run": "node scripts/migrate_offers_to_listings.mjs --dry-run",
    "marketplace:migrate:offers-to-listings": "node scripts/migrate_offers_to_listings.mjs",
    "marketplace:migrate:offers-to-listings:v2:dry-run": "node --experimental-strip-types scripts/migrateOffersToListings.ts --dry-run",
    "marketplace:migrate:offers-to-listings:v2": "node --experimental-strip-types scripts/migrateOffersToListings.ts --apply",
    "marketplace:migrate:favorites:dry-run": "node --experimental-strip-types scripts/migrateFavoriteOffersToFavorites.ts --dry-run",
    "marketplace:migrate:favorites": "node --experimental-strip-types scripts/migrateFavoriteOffersToFavorites.ts --apply",
    "marketplace:migrate:profiles:dry-run": "node --experimental-strip-types scripts/migrateProfilesToUsers.ts --dry-run",
    "marketplace:migrate:profiles": "node --experimental-strip-types scripts/migrateProfilesToUsers.ts --apply",
    "test:firestore:public-listings": "firebase emulators:exec --config ../firebase.json --only firestore \"node scripts/test_public_listings_rules.mjs\"",
    "test:firestore:canonical-rules": "firebase emulators:exec --config ../firebase.json --only firestore \"node scripts/test_canonical_marketplace_rules.mjs\"",
    "test": "npm run build && node --test $(find lib -name '*.test.js' -print)",
    "email:audit:new-events": "node scripts/audit_new_email_events.mjs",
    "brevo:webhook:smoke": "node scripts/brevo_webhook_smoke_test.mjs",
    "messaging:backfill:mirror:dry-run": "npm run build && node scripts/backfill_conversation_mirror_fields.mjs --dry-run",
    "messaging:backfill:mirror": "npm run build && node scripts/backfill_conversation_mirror_fields.mjs",
    "offers:backfill:indexes:dry-run": "node scripts/backfill_offer_indexes.mjs --dry-run",
    "offers:backfill:indexes": "node scripts/backfill_offer_indexes.mjs",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "npm run build && firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google-cloud/speech": "^6.7.1",
    "@google-cloud/vertexai": "^1.10.0",
    "ffmpeg-static": "^5.2.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.2.5",
    "google-auth-library": "^9.15.1",
    "nodemailer": "^6.10.1",
    "openai": "^4.104.0",
    "resend": "^3.2.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^20.19.39",
    "firebase": "^11.10.0",
    "typescript": "^5.4.5"
  }
}
