{
  "name": "presto-functions",
  "version": "1.0.0",
  "description": "Cloud Functions pour Presto App",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "marketplace:seed": "node scripts/seed_marketplace_bootstrap.mjs",
    "marketplace:seed:dry-run": "node scripts/seed_marketplace_bootstrap.mjs --dry-run",
    "test": "npm run build && node --test $(find lib -name '*.test.js' -print)",
    "email:audit:new-events": "node scripts/audit_new_email_events.mjs",
    "brevo:webhook:smoke": "node scripts/brevo_webhook_smoke_test.mjs",
    "messaging:backfill:mirror:dry-run": "npm run build && node scripts/backfill_conversation_mirror_fields.mjs --dry-run",
    "messaging:backfill:mirror": "npm run build && node scripts/backfill_conversation_mirror_fields.mjs",
    "offers:backfill:indexes:dry-run": "node scripts/backfill_offer_indexes.mjs --dry-run",
    "offers:backfill:indexes": "node scripts/backfill_offer_indexes.mjs",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "npm run build && firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google-cloud/speech": "^6.7.1",
    "@google-cloud/vertexai": "^1.10.0",
    "ffmpeg-static": "^5.2.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.2.2",
    "google-auth-library": "^9.15.1",
    "nodemailer": "^6.10.1",
    "openai": "^4.104.0",
    "resend": "^3.2.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5"
  }
}
