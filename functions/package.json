{
  "name": "presto-functions",
  "version": "1.0.0",
  "description": "Cloud Functions pour Presto App",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "npm run build && node --test lib/**/*.test.js",
    "brevo:webhook:smoke": "node scripts/brevo_webhook_smoke_test.mjs",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "npm run build && firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google-cloud/speech": "^6.7.1",
    "@google-cloud/vertexai": "^1.10.0",
    "ffmpeg-static": "^5.2.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.2",
    "nodemailer": "^6.10.1",
    "openai": "^4.104.0",
    "resend": "^3.2.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5"
  }
}
