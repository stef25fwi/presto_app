{
  "hosting": {
    "target": "redirect",
    "public": "redirect_public",
    "ignore": [
      "firebase.redirect.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://ilipresto.web.app",
        "type": 301
      },
      {
        "source": "/:path*",
        "destination": "https://ilipresto.web.app/:path",
        "type": 301
      }
    ]
  }
}
