rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return hasClaimRole('admin')
        || hasClaimRole('superadmin')
        || hasUserDocRole('admin')
        || hasUserDocRole('superadmin')
        || (isSignedIn()
          && exists(/databases/$(database)/documents/admins/$(uid()))
          && (get(/databases/$(database)/documents/admins/$(uid())).data.enabled != false));
    }

    function hasClaimRole(role) {
      return isSignedIn()
        && (request.auth.token.roles is list)
        && request.auth.token.roles.hasAny([role]);
    }

    function hasUserDocRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && (
          ((get(/databases/$(database)/documents/users/$(uid())).data.roles is list)
            && get(/databases/$(database)/documents/users/$(uid())).data.roles.hasAny([role]))
          || get(/databases/$(database)/documents/users/$(uid())).data.primaryRole == role
          || (role == 'moderator' && get(/databases/$(database)/documents/users/$(uid())).data.moderator == true)
          || (role == 'admin' && get(/databases/$(database)/documents/users/$(uid())).data.admin == true)
          || (role == 'superadmin' && get(/databases/$(database)/documents/users/$(uid())).data.superadmin == true)
        );
    }

    function isMarketplaceModerator() {
      return hasClaimRole('moderator')
        || hasUserDocRole('moderator')
        || hasClaimRole('admin')
        || hasUserDocRole('admin')
        || hasClaimRole('superadmin')
        || hasUserDocRole('superadmin')
        || isAdmin();
    }

    function isMarketplaceAdmin() {
      return hasClaimRole('admin')
        || hasUserDocRole('admin')
        || hasClaimRole('superadmin')
        || hasUserDocRole('superadmin')
        || isAdmin();
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isPublicListingData(data) {
      return (
        (data.status == 'active' && data.visibility == 'public')
        || data.status == 'published'
        || data.isPublished == true
        || data.isActive == true
        || ((data.visibility is map) && data.visibility.isPublic == true)
      );
    }

    function isListingOwner(data) {
      return isSignedIn() && data.ownerId == uid();
    }

    function isChatParticipant(data) {
      return isSignedIn()
        && ((data.participants is list) && data.participants.hasAny([uid()]));
    }

    function isOwnerByField(data) {
      return isSignedIn() && (
        (data.userId is string && data.userId == uid()) ||
        (data.ownerId is string && data.ownerId == uid()) ||
        (data.uid is string && data.uid == uid())
      );
    }

    function isPublicOffer() {
      // Toute annonce publiée est visible publiquement, quel que soit le modèle
      // utilisé par la version du client qui l'a écrite.
      return (resource.data.visibility.isPublic == true)
        || (resource.data.isPublished == true)
        || (resource.data.isActive == true)
        || (resource.data.status == 'active')
        || (resource.data.status == 'published');
    }

    // ⛔️ Server-only: rate limits (Functions)
    match /_rate_limits/{docId} {
      allow read, write: if false;
    }

    // ⛔️ Admins config (Functions)
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // ✅ Users: chaque utilisateur gère son doc
    match /users/{userId} {
      allow read: if isSignedIn() && (userId == uid() || isMarketplaceModerator());
      allow create: if isSignedIn()
        && userId == uid()
        && !request.resource.data.keys().hasAny([
          'roles',
          'primaryRole',
          'status',
          'moderationStrikeCount',
          'spamScore',
          'trustedSeller',
          'lastRoleSyncAt',
          'lastRecaptchaScore'
        ]);
      allow update: if isSignedIn()
        && userId == uid()
        && !changedKeys().hasAny([
          'roles',
          'primaryRole',
          'status',
          'moderationStrikeCount',
          'spamScore',
          'trustedSeller',
          'lastRoleSyncAt',
          'lastRecaptchaScore'
        ]);
      allow delete: if isSignedIn() && userId == uid();

      match /push_tokens/{tokenId} {
        allow read, create, update, delete: if false;
      }

      // Sous-collection notifications (si jamais utilisée un jour)
      match /notifications/{notifId} {
        allow read, update, delete: if isSignedIn() && userId == uid();
        allow create: if false; // server-only
      }

      match /favoriteOffers/{offerId} {
        allow read, create, update, delete: if isSignedIn() && userId == uid();
      }
    }

    match /profiles/{profileId} {
      allow read: if true;
      allow create: if isSignedIn()
        && profileId == uid()
        && request.resource.data.userId == uid()
        && !request.resource.data.keys().hasAny(['roles', 'status', 'isVerified', 'trustedSeller']);
      allow update: if isSignedIn()
        && profileId == uid()
        && resource.data.userId == uid()
        && request.resource.data.userId == resource.data.userId
        && !changedKeys().hasAny(['roles', 'status', 'isVerified', 'trustedSeller']);
      allow delete: if false;
    }

    match /listingDrafts/{draftId} {
      allow read: if isSignedIn() && resource.data.ownerId == uid();
      allow create: if isSignedIn()
        && request.resource.data.ownerId == uid()
        && !request.resource.data.keys().hasAny([
          'listingId',
          'submittedAt',
          'moderationStatus',
          'riskScore',
          'reportCount',
          'favoriteCount',
          'viewCount',
          'contactCount',
          'publishedAt',
          'reviewedBy',
          'reviewedAt'
        ]);
      allow update: if isSignedIn()
        && resource.data.ownerId == uid()
        && request.resource.data.ownerId == resource.data.ownerId
        && !changedKeys().hasAny([
          'listingId',
          'submittedAt',
          'moderationStatus',
          'riskScore',
          'reportCount',
          'favoriteCount',
          'viewCount',
          'contactCount',
          'publishedAt',
          'reviewedBy',
          'reviewedAt'
        ]);
      allow delete: if isSignedIn() && resource.data.ownerId == uid();
    }

    match /listings/{listingId} {
      allow read: if isPublicListingData(resource.data)
        || isListingOwner(resource.data)
        || isMarketplaceModerator();
      allow create, update, delete: if false;
    }

    match /listingModeration/{listingId} {
      allow read: if isMarketplaceModerator()
        || (isSignedIn() && resource.data.ownerId == uid());
      allow write: if false;
    }

    match /listingReports/{reportId} {
      allow read: if isMarketplaceModerator()
        || (isSignedIn() && resource.data.reporterId == uid());
      allow create, update, delete: if false;
    }

    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && resource.data.userId == uid();
      allow write: if false;
    }

    match /chatThreads/{threadId} {
      allow read: if isChatParticipant(resource.data) || isMarketplaceModerator();
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && exists(/databases/$(database)/documents/chatThreads/$(threadId))
          && isChatParticipant(get(/databases/$(database)/documents/chatThreads/$(threadId)).data);
        allow create, update, delete: if false;
      }
    }

    match /adminActions/{actionId} {
      allow read: if isMarketplaceModerator();
      allow write: if false;
    }

    match /admin_runtime_audio/{docId} {
      allow read, create, update, delete: if isMarketplaceAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /cities/{cityId} {
      allow read: if true;
      allow write: if false;
    }

    match /analyticsSnapshots/{snapshotId} {
      allow read: if isMarketplaceAdmin();
      allow write: if false;
    }

    match /appConfig/{configId} {
      allow read: if isMarketplaceAdmin();
      allow write: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isMarketplaceAdmin();
      allow write: if false;
    }

    match /billing_invoices/{invoiceId} {
      allow read: if isMarketplaceAdmin();
      allow write: if false;
    }

    match /notification_preferences/{userId} {
      allow read: if isSignedIn() && userId == uid();
      allow create: if isSignedIn()
        && userId == uid()
        && request.resource.data.user_id == uid();
      allow update: if isSignedIn()
        && userId == uid()
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.user_id == uid();
      allow delete: if false;
    }

    match /support_tickets/{ticketId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.user_id == uid());
      allow create: if isSignedIn()
        && request.resource.data.user_id == uid()
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 4
        && request.resource.data.description is string
        && request.resource.data.description.size() > 9
        && request.resource.data.status == 'open';
      allow update, delete: if false;
    }

    match /system_settings/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /email_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /email_jobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /reports/{reportId} {
      allow read: if isSignedIn() && resource.data.reporter_id == uid();
      allow create: if isSignedIn()
        && request.resource.data.reporter_id == uid()
        && request.resource.data.keys().hasAll(['reporter_id', 'reason'])
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 2000;
      allow update, delete: if false;
    }

    // ✅ Pros: chaque pro gère son doc (profil + statut)
    match /pros/{proId} {
      allow read: if isSignedIn() && proId == uid();
      allow create: if isSignedIn() && proId == uid()
        && !request.resource.data.keys().hasAny(['verified', 'trustedSeller', 'roles', 'status']);
      allow update: if isSignedIn() && proId == uid()
        && !changedKeys().hasAny(['verified', 'trustedSeller', 'roles', 'status']);
      allow delete: if isSignedIn() && proId == uid();
    }

    // ✅ Notifications globales (utilisées par l'app)
    match /notifications/{notifId} {
      // Lecture uniquement par le propriétaire
      allow read: if isSignedIn() && resource.data.userId == uid();

      // Le client peut seulement marquer "read" à true/false sur ses notifs.
      // On vérifie que les champs critiques ne changent pas (quand ils existent).
      allow update: if isSignedIn()
        && resource.data.userId == uid()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.read is bool
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read']);

      allow create, delete: if false; // server-only
    }

    // ✅ Offers
    match /offers/{offerId} {
      // Lecture publique (annonces)
      allow read: if isPublicOffer() || isAdmin() || isOwnerByField(resource.data);

      // Création par utilisateur connecté, ownership obligatoire
      allow create: if isSignedIn()
        && isOwnerByField(request.resource.data)
        // Empêche de créer une annonce "au nom" d'un autre
        && (!('userId' in request.resource.data) || request.resource.data.userId == uid())
        && (!('ownerId' in request.resource.data) || request.resource.data.ownerId == uid())
        && (!('uid' in request.resource.data) || request.resource.data.uid == uid())
        // Limite de taille (title, description)
        && (!('title' in request.resource.data) || request.resource.data.title.size() <= 200)
        && (!('description' in request.resource.data) || request.resource.data.description.size() <= 5000)
        // Bloque les champs réservés aux Functions
        && !request.resource.data.keys().hasAny([
          'moderation', 'visibility', 'riskScore', 'reportCount',
          'favoriteCount', 'viewCount', 'contactCount', 'reviewedBy', 'reviewedAt'
        ]);

      // Update uniquement propriétaire (et champs server-only protégés)
      allow update: if isSignedIn()
        && isOwnerByField(resource.data)
        // Interdit d'éditer des champs réservés aux Functions
        && !changedKeys().hasAny([
          'moderation', 'visibility', 'riskScore', 'reportCount',
          'favoriteCount', 'viewCount', 'contactCount', 'reviewedBy', 'reviewedAt'
        ])
        // Limite de taille
        && (!('title' in request.resource.data) || request.resource.data.title.size() <= 200)
        && (!('description' in request.resource.data) || request.resource.data.description.size() <= 5000);

      // Delete uniquement propriétaire
      allow delete: if isSignedIn()
        && isOwnerByField(resource.data);
    }

    // ✅ Conversations & messages
    match /conversations/{conversationId} {
      function isParticipantInConversationData(data) {
        return isSignedIn()
          && (
            ((data.participants is list) && data.participants.hasAny([uid()]))
            || ((data.participant_ids is list) && data.participant_ids.hasAny([uid()]))
            || ((data.participantIds is list) && data.participantIds.hasAny([uid()]))
            || ((data.userIds is list) && data.userIds.hasAny([uid()]))
            || ((data.memberIds is list) && data.memberIds.hasAny([uid()]))
            || ((data.participantNames is map) && data.participantNames.keys().hasAny([uid()]))
            || ((data.participant_names is map) && data.participant_names.keys().hasAny([uid()]))
            || ((data.unreadCount is map) && data.unreadCount.keys().hasAny([uid()]))
            || ((data.unread_count is map) && data.unread_count.keys().hasAny([uid()]))
            || ((data.lastReadAt is map) && data.lastReadAt.keys().hasAny([uid()]))
            || ((data.last_read_at is map) && data.last_read_at.keys().hasAny([uid()]))
            || ((data.archivedBy is map) && data.archivedBy.keys().hasAny([uid()]))
            || ((data.blockedBy is map) && data.blockedBy.keys().hasAny([uid()]))
          );
      }

      function isParticipant() {
        return isParticipantInConversationData(resource.data);
      }

      function parentConversationExists() {
        return exists(/databases/$(database)/documents/conversations/$(conversationId));
      }

      function isParentConversationParticipant() {
        let convData = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        return parentConversationExists()
          && isParticipantInConversationData(convData);
      }

      allow read: if isParticipant();

      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if isParentConversationParticipant();
        allow create, update, delete: if false;
      }
    }

    // Debug MicroIA: écriture uniquement par l'utilisateur, pas de lecture client
    match /debug_microia/{docId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == uid();
      allow update, delete: if false;
    }

    // ⛔️ Par défaut : rien
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
