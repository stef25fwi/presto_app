rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profils utilisateurs : lecture/écriture réservées au propriétaire
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Offres : lecture publique, écriture réservée au propriétaire de l'offre
    match /offers/{offerId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Conversations (métadonnées)
    match /conversations/{convId} {
      allow read, update, delete: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants;
    }

    // Messages d'une conversation
    match /conversations/{convId}/messages/{msgId} {
      function conv() {
        return get(/databases/$(database)/documents/conversations/$(convId));
      }

      allow read: if request.auth != null && request.auth.uid in conv().data.participants;

      allow create: if request.auth != null
        && request.auth.uid in conv().data.participants
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.createdAt is timestamp;

      // Pas de modification/suppression des messages par les clients
      allow update, delete: if false;
    }

    // Notifications : lecture/écriture uniquement par le destinataire
    match /notifications/{notifId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Refus par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
