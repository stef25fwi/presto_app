rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasAppCheck() {
      return request.app != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return hasAdminClaim()
        || hasUserDocAdminRole()
        || hasEnabledAdminDoc()
        || hasEnabledAdminUserDoc();
    }

    function isAdminClaim() {
      return hasAdminClaim();
    }

    function hasAdminClaim() {
      return isSignedIn()
        && (
          ((request.auth.token.roles is list)
            && request.auth.token.roles.hasAny(['admin', 'superadmin']))
          || request.auth.token.role == 'admin'
          || request.auth.token.role == 'superadmin'
          || request.auth.token.primaryRole == 'admin'
          || request.auth.token.primaryRole == 'superadmin'
          || request.auth.token.adminRole == 'admin'
          || request.auth.token.adminRole == 'superadmin'
          || request.auth.token.admin == true
          || request.auth.token.isAdmin == true
          || request.auth.token.superadmin == true
          || request.auth.token.superAdmin == true
        );
    }

    function hasUserDocAdminRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && (
          ((get(/databases/$(database)/documents/users/$(uid())).data.roles is list)
            && get(/databases/$(database)/documents/users/$(uid())).data.roles.hasAny(['admin', 'superadmin']))
          || ((get(/databases/$(database)/documents/users/$(uid())).data.roles is map)
            && (get(/databases/$(database)/documents/users/$(uid())).data.roles.admin == true
              || get(/databases/$(database)/documents/users/$(uid())).data.roles.superadmin == true
              || get(/databases/$(database)/documents/users/$(uid())).data.roles.superAdmin == true))
          || get(/databases/$(database)/documents/users/$(uid())).data.role == 'admin'
          || get(/databases/$(database)/documents/users/$(uid())).data.role == 'superadmin'
          || get(/databases/$(database)/documents/users/$(uid())).data.primaryRole == 'admin'
          || get(/databases/$(database)/documents/users/$(uid())).data.primaryRole == 'superadmin'
          || get(/databases/$(database)/documents/users/$(uid())).data.adminRole == 'admin'
          || get(/databases/$(database)/documents/users/$(uid())).data.adminRole == 'superadmin'
          || get(/databases/$(database)/documents/users/$(uid())).data.admin == true
          || get(/databases/$(database)/documents/users/$(uid())).data.isAdmin == true
          || get(/databases/$(database)/documents/users/$(uid())).data.superadmin == true
          || get(/databases/$(database)/documents/users/$(uid())).data.superAdmin == true
        );
    }

    function hasEnabledAdminDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(uid()))
        && get(/databases/$(database)/documents/admins/$(uid())).data.enabled != false
        && (!('expiresAt' in get(/databases/$(database)/documents/admins/$(uid())).data)
          || get(/databases/$(database)/documents/admins/$(uid())).data.expiresAt > request.time);
    }

    function hasEnabledAdminUserDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(uid()))
        && get(/databases/$(database)/documents/adminUsers/$(uid())).data.enabled != false
        && (!('expiresAt' in get(/databases/$(database)/documents/adminUsers/$(uid())).data)
          || get(/databases/$(database)/documents/adminUsers/$(uid())).data.expiresAt > request.time);
    }

    function hasClaimRole(role) {
      return isSignedIn()
        && (request.auth.token.roles is list)
        && request.auth.token.roles.hasAny([role]);
    }

    function hasUserDocRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && (
          ((get(/databases/$(database)/documents/users/$(uid())).data.roles is list)
            && get(/databases/$(database)/documents/users/$(uid())).data.roles.hasAny([role]))
          || ((get(/databases/$(database)/documents/users/$(uid())).data.roles is map)
            && get(/databases/$(database)/documents/users/$(uid())).data.roles[role] == true)
          || get(/databases/$(database)/documents/users/$(uid())).data.role == role
          || get(/databases/$(database)/documents/users/$(uid())).data.primaryRole == role
          || (role == 'moderator' && get(/databases/$(database)/documents/users/$(uid())).data.moderator == true)
          || (role == 'admin' && get(/databases/$(database)/documents/users/$(uid())).data.admin == true)
          || (role == 'superadmin' && get(/databases/$(database)/documents/users/$(uid())).data.superadmin == true)
        );
    }

    function hasParticipantAccess(data) {
      return isSignedIn()
        && (
          data.userId == uid()
          || data.uid == uid()
          || data.ownerId == uid()
          || data.createdBy == uid()
          || data.senderId == uid()
          || data.sender_id == uid()
          || data.recipientId == uid()
          || data.recipient_id == uid()
          || data.receiverId == uid()
          || data.receiver_id == uid()
          || data.buyerId == uid()
          || data.buyer_id == uid()
          || data.sellerId == uid()
          || data.seller_id == uid()
          || data.clientId == uid()
          || data.client_id == uid()
          || data.providerId == uid()
          || data.provider_id == uid()
          || ((data.participants is list) && data.participants.hasAny([uid()]))
          || ((data.participant_ids is list) && data.participant_ids.hasAny([uid()]))
          || ((data.participantIds is list) && data.participantIds.hasAny([uid()]))
          || ((data.memberIds is list) && data.memberIds.hasAny([uid()]))
          || ((data.users is list) && data.users.hasAny([uid()]))
          || ((data.userIds is list) && data.userIds.hasAny([uid()]))
          || ((data.participantsMap is map) && data.participantsMap[uid()] == true)
        );
    }

    function canReadNotification(data) {
      return hasAppCheck()
        && (isAdmin()
        || (isSignedIn()
          && (
            data.userId == uid()
            || data.uid == uid()
            || data.recipientId == uid()
            || data.receiverId == uid()
            || data.toUid == uid()
            || data.ownerId == uid()
          )));
    }

    function isMarketplaceModerator() {
      return hasClaimRole('moderator')
        || hasUserDocRole('moderator')
        || hasClaimRole('admin')
        || hasUserDocRole('admin')
        || hasClaimRole('superadmin')
        || hasUserDocRole('superadmin')
        || isAdmin();
    }

    function isMarketplaceAdmin() {
      return hasClaimRole('admin')
        || hasUserDocRole('admin')
        || hasClaimRole('superadmin')
        || hasUserDocRole('superadmin')
        || isAdmin();
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function protectedUserFields() {
      return [
        'roles',
        'role',
        'primaryRole',
        'verified',
        'isVerified',
        'status',
        'marketplaceAccess',
        'moderationStrikeCount',
        'spamScore',
        'trustedSeller',
        'lastRoleSyncAt',
        'lastRecaptchaScore',
        'createdAt',
        'disabled',
        'last_login_ip',
        'login_signatures',
        'last_login_signature',
        'admin',
        'superadmin',
        'moderator',
        'isAdmin',
        'isModerator',
        'isSuperadmin',
        'superAdmin',
        'trustScore'
      ];
    }

    function isPublicListingData(data) {
      // Canonical public marketplace listing shape.
      return data.status == 'active'
        && data.visibility == 'public';
    }

    function isListingOwner(data) {
      return isSignedIn() && data.ownerId == uid();
    }

    function isOwnerByField(data) {
      return isSignedIn() && (
        (data.userId is string && data.userId == uid()) ||
        (data.ownerId is string && data.ownerId == uid()) ||
        (data.uid is string && data.uid == uid())
      );
    }

    function isPublicOffer() {
      // Toute annonce active est visible publiquement — chaque branche correspond
      // à un variant de query validable statiquement par Firestore.
      return resource.data.status == 'active'
        || resource.data.status == 'published'
        || resource.data.isPublished == true
        || resource.data.isActive == true
        || resource.data.visibility == 'public'
        || (resource.data.visibility is map && resource.data.visibility.get('isPublic', false) == true);
    }

    function isValidHeroSlide(data) {
      return data.keys().hasOnly([
          'id',
          'title',
          'mediaUrl',
          'storagePath',
          'mediaType',
          'durationSeconds',
          'order',
          'isActive',
          'isFirst',
          'createdAt',
          'updatedAt',
          'createdBy'
        ])
        && data.id is string
        && data.id.size() > 0
        && data.id.size() <= 128
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 80
        && data.mediaUrl is string
        && data.mediaUrl.size() > 0
        && data.mediaUrl.size() <= 2048
        && data.storagePath is string
        && data.storagePath.matches('^hero_slides/.+')
        && data.mediaType in ['image', 'video']
        && data.durationSeconds is int
        && data.durationSeconds >= 3
        && data.durationSeconds <= 60
        && data.order is int
        && data.order >= 0
        && data.order <= 1000
        && data.isActive is bool
        && data.isFirst is bool
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /heroSlides/{slideId} {
      allow read: if resource.data.isActive == true || isMarketplaceAdmin();
      allow create: if isMarketplaceAdmin()
        && request.resource.data.id == slideId
        && request.resource.data.createdBy == uid()
        && isValidHeroSlide(request.resource.data);
      allow update: if isMarketplaceAdmin()
        && isValidHeroSlide(request.resource.data);
      allow delete: if isMarketplaceAdmin();
    }

    // ⛔ [REFUSÉ] Rate limits — server-only (Functions)
    match /_rate_limits/{docId} {
      allow read, write: if false;
    }

    // ⛔ [REFUSÉ] Configuration admins — server-only (Functions)
    match /admins/{adminId} {
      allow read, write: if false;
    }

    match /adminUsers/{adminId} {
      allow get: if isSignedIn() && (uid() == adminId || isAdminClaim());
      allow list: if isAdminClaim();
      allow create, update, delete: if isAdminClaim();
    }

    // ✅ [AUTORISÉ] Users — chaque utilisateur gère son doc
    match /users/{userId} {
      allow read: if isSignedIn() && (userId == uid() || (hasAppCheck() && isMarketplaceModerator()));
      allow create: if hasAppCheck()
        && isSignedIn()
        && userId == uid()
        && !request.resource.data.keys().hasAny(protectedUserFields());
      allow update: if isSignedIn()
        && userId == uid()
        && !changedKeys().hasAny(protectedUserFields());
      allow delete: if hasAppCheck() && isSignedIn() && userId == uid();

      match /push_tokens/{tokenId} {
        allow read, create, update, delete: if false;
      }

      match /metadata/{metadataId} {
        allow read: if isSignedIn() && userId == uid();
        allow create, update, delete: if false;
      }

      // ℹ️ [INFO] Sous-collection notifications — réservée pour usage futur
      match /notifications/{notifId} {
        allow read, update, delete: if hasAppCheck() && isSignedIn() && userId == uid();
        allow create: if false; // ⛔ server-only
      }

      match /favoriteOffers/{offerId} {
        allow read: if isSignedIn() && userId == uid();
        allow create, update, delete: if false; // LEGACY READ-ONLY UNTIL MIGRATION COMPLETE.
      }

      match /favorites/{offerId} {
        allow read, write: if isSignedIn() && userId == uid();
      }
    }

    // 🔒 [SÉCURITÉ] Profiles — lecture restreinte au propriétaire ou modérateur
    match /profiles/{profileId} {
      allow read: if hasAppCheck() && isSignedIn() && (profileId == uid() || isMarketplaceModerator());
      allow create, update, delete: if false; // LEGACY READ-ONLY UNTIL MIGRATION COMPLETE.
    }

    match /listingDrafts/{draftId} {
      allow read: if (hasAppCheck() && isSignedIn() && resource.data.ownerId == uid()) || isAdmin();
      allow create, update: if false;
      allow delete: if hasAppCheck() && isSignedIn() && resource.data.ownerId == uid();
    }

    match /listings/{listingId} {
      allow read: if isPublicListingData(resource.data)
        || isListingOwner(resource.data)
        || isMarketplaceModerator();
      allow create, update, delete: if false;
    }

    match /listingModeration/{listingId} {
      allow read: if isMarketplaceModerator()
        || (hasAppCheck() && isSignedIn() && resource.data.ownerId == uid());
      allow write: if false;
    }

    match /listingReports/{reportId} {
      allow read: if isMarketplaceModerator()
        || (hasAppCheck() && isSignedIn() && resource.data.reporterId == uid());
      allow create, update, delete: if false;
    }

    match /listingPhotoReviews/{reviewId} {
      allow read: if isMarketplaceModerator();
      allow create, update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if isMarketplaceModerator()
        || (hasAppCheck()
          && resource.data.status == 'published'
          && resource.data.visibleOnProfile == true
          && resource.data.isVerified == true)
        || (hasAppCheck()
          && isSignedIn()
          && (resource.data.reviewerId == uid()
            || resource.data.reviewedUserId == uid()));
      allow create, update, delete: if false;
    }

    match /review_reports/{reportId} {
      allow read: if isMarketplaceModerator()
        || (hasAppCheck() && isSignedIn() && resource.data.reportedBy == uid());
      allow create, update, delete: if false;
    }

    match /review_replies/{replyId} {
      allow read: if isMarketplaceModerator()
        || (hasAppCheck() && isSignedIn() && resource.data.reviewedUserId == uid())
        || (hasAppCheck() && resource.data.status == 'published');
      allow create, update, delete: if false;
    }

    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && resource.data.userId == uid();
      allow write: if false;
    }

    match /adminActions/{actionId} {
      allow read: if isMarketplaceModerator();
      allow write: if false;
    }

    match /admin_runtime_audio/{docId} {
      allow read: if isMarketplaceAdmin();
      allow create, update: if isMarketplaceAdmin()
        && request.resource.data.keys().hasOnly([
          'audioUrl', 'transcription', 'createdAt', 'updatedAt',
          'createdBy', 'status', 'metadata'
        ]);
      allow delete: if isMarketplaceAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /cities/{cityId} {
      allow read: if true;
      allow write: if false;
    }

    match /analyticsSnapshots/{snapshotId} {
      allow read: if isMarketplaceAdmin();
      allow write: if false;
    }

    match /appConfig/{configId} {
      allow read: if isMarketplaceAdmin();
      allow write: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isMarketplaceAdmin();
      allow write: if false;
    }

    match /billing_invoices/{invoiceId} {
      allow read: if isMarketplaceAdmin();
      allow write: if false;
    }

    match /notification_preferences/{userId} {
      allow read: if hasAppCheck() && isSignedIn() && userId == uid();
      allow create: if isSignedIn()
        && hasAppCheck()
        && userId == uid()
        && request.resource.data.user_id == uid()
        && request.resource.data.keys().hasOnly([
          'user_id', 'locale', 'timezone', 'quiet_hours',
          'email', 'push', 'in_app', 'sms',
          'updatedAt', 'createdAt'
        ]);
      allow update: if isSignedIn()
        && hasAppCheck()
        && userId == uid()
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.user_id == uid()
        && request.resource.data.keys().hasOnly([
          'user_id', 'locale', 'timezone', 'quiet_hours',
          'email', 'push', 'in_app', 'sms',
          'updatedAt', 'createdAt'
        ]);
      allow delete: if false;
    }

    match /support_tickets/{ticketId} {
      allow read: if isAdmin() || (hasAppCheck() && isSignedIn() && resource.data.user_id == uid());
      allow create: if isSignedIn()
        && hasAppCheck()
        && request.resource.data.user_id == uid()
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 4
        && request.resource.data.description is string
        && request.resource.data.description.size() > 9
        && request.resource.data.status == 'open';
      allow update, delete: if false;
    }

    match /system_settings/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /email_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /email_jobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /reports/{reportId} {
      allow read, create, update, delete: if false;
    }

    // ✅ [AUTORISÉ] Pros — chaque professionnel gère son doc
    match /pros/{proId} {
      allow read: if hasAppCheck() && isSignedIn() && proId == uid();
      allow create: if hasAppCheck() && isSignedIn() && proId == uid()
        && (!('status' in request.resource.data) || request.resource.data.status == 'pending')
        && !request.resource.data.keys().hasAny(['verified', 'trustedSeller', 'roles']);
      allow update: if hasAppCheck() && isSignedIn() && proId == uid()
        && !changedKeys().hasAny(['verified', 'trustedSeller', 'roles', 'status']);
      allow delete: if hasAppCheck() && isSignedIn() && proId == uid();
    }

    // ✅ [AUTORISÉ] Notifications globales
    match /notifications/{notifId} {
      allow get, list: if canReadNotification(resource.data);

      // 🔒 [SÉCURITÉ] Le client ne peut modifier que le champ 'read'
      allow update: if isSignedIn()
        && hasAppCheck()
        && resource.data.userId == uid()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.read is bool
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read']);

      allow create, delete: if false; // ⛔ server-only
    }

    // ✅ [AUTORISÉ] Offers — annonces utilisateur
    match /offers/{offerId} {
      // LEGACY READ-ONLY UNTIL MIGRATION COMPLETE.
      // ℹ️ [INFO] Lecture publique (annonces)
      allow read: if isPublicOffer() || isAdmin() || isOwnerByField(resource.data);
      allow create, update, delete: if false;
    }

    // ✅ [AUTORISÉ] Conversations et messages
    match /conversations/{conversationId} {
      function isParticipantInConversationId() {
        return isSignedIn()
          && (
            conversationId.matches('^offer_.+__' + uid() + '__.+$')
            || conversationId.matches('^offer_.+__.+__' + uid() + '$')
          );
      }

      function isParticipantInConversationData(data) {
        return hasParticipantAccess(data)
          || isParticipantInConversationId()
          || (isSignedIn()
            && (
              ((data.participantNames is map) && data.participantNames.keys().hasAny([uid()]))
              || ((data.participant_names is map) && data.participant_names.keys().hasAny([uid()]))
              || ((data.unreadCount is map) && data.unreadCount.keys().hasAny([uid()]))
              || ((data.unread_count is map) && data.unread_count.keys().hasAny([uid()]))
              || ((data.lastReadAt is map) && data.lastReadAt.keys().hasAny([uid()]))
              || ((data.last_read_at is map) && data.last_read_at.keys().hasAny([uid()]))
              || ((data.archivedBy is map) && data.archivedBy.keys().hasAny([uid()]))
              || ((data.blockedBy is map) && data.blockedBy.keys().hasAny([uid()]))
            ));
      }

      function parentConversationExists() {
        return exists(/databases/$(database)/documents/conversations/$(conversationId));
      }

      function isParentConversationParticipant() {
        let convData = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        return parentConversationExists()
          && isParticipantInConversationData(convData);
      }

      function canReadConversationAsAdmin() {
        // Admin access is already protected by Firebase Auth custom claims / admin docs.
        // Do not require App Check here, otherwise a valid admin can be blocked on web
        // when App Check activation/token is missing while rules still see isAdmin() == true.
        return isAdmin();
      }

      function canReadConversationAsParticipant(data) {
        // Auth + participant membership protect private messages. Do not block
        // the inbox on web when App Check / reCAPTCHA is temporarily rejected.
        // Message writes still go through validated Cloud Functions or a strict
        // client fallback guarded by parent participant checks.
        return isParticipantInConversationData(data);
      }

      function isValidClientMessageCreate() {
        return request.resource.data.keys().hasOnly([
            'text',
            'body',
            'attachments',
            'senderId',
            'sender_id',
            'senderName',
            'sender_name',
            'isFirstMessage',
            'createdAt',
            'created_at',
            'createdVia',
            'clientMutationId'
          ])
          && request.resource.data.senderId == uid()
          && request.resource.data.sender_id == uid()
          && request.resource.data.createdVia == 'client_firestore_fallback'
          && request.resource.data.createdAt == request.time
          && request.resource.data.created_at == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.body == request.resource.data.text
          && (!('senderName' in request.resource.data) || request.resource.data.senderName is string)
          && (!('sender_name' in request.resource.data) || request.resource.data.sender_name is string)
          && (!('isFirstMessage' in request.resource.data) || request.resource.data.isFirstMessage is bool)
          && (!('clientMutationId' in request.resource.data) || request.resource.data.clientMutationId is string);
      }

      allow get: if canReadConversationAsAdmin() || canReadConversationAsParticipant(resource.data);
      allow list: if canReadConversationAsAdmin() || canReadConversationAsParticipant(resource.data);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow get, list: if isAdmin()
          || isParentConversationParticipant()
          || hasParticipantAccess(resource.data);
        allow create: if isParentConversationParticipant()
          && isValidClientMessageCreate();
        allow update, delete: if false;
      }
    }

    // ℹ️ [INFO] Debug MicroIA — écriture utilisateur, lecture refusée
    match /debug_microia/{docId} {
      allow read: if false;
      allow create: if isSignedIn()
        && hasAppCheck()
        && request.resource.data.uid == uid();
      allow update, delete: if false;
    }

    // ⛔ [REFUSÉ] Email events — server-only
    match /email_events/{eventId} {
      allow read, write: if false;
    }

    // ⛔ [REFUSÉ] Email suppressions — server-only
    match /email_suppressions/{docId} {
      allow read, write: if false;
    }

    // ⛔ [REFUSÉ] Archive listings supprimés — modération, RGPD
    match /deletedListings/{listingId} {
      allow read: if isMarketplaceAdmin();
      allow write: if false;
    }

    // ⛔ [REFUSÉ] Push tokens — server-only
    match /push_tokens/{tokenId} {
      allow read, write: if false;
    }


    // cache_analytics — lecture admin, écriture serveur uniquement
    match /cache_analytics/{docId} {
      allow read: if isMarketplaceAdmin();
      allow write: if false;
    }

    // parcours — lecture propriétaire ou admin
    match /parcours/{parcoursId} {
      allow read: if isSignedIn()
        && (isAdmin() || resource.data.userId == uid() || resource.data.ownerId == uid());
      allow write: if false;
    }

    // toolbox_journeys — lecture propriétaire ou admin
    match /toolbox_journeys/{journeyId} {
      allow read: if isSignedIn()
        && (isAdmin() || resource.data.userId == uid() || resource.data.ownerId == uid());
      allow write: if false;
    }

    // toolbox_journey_index — lecture propriétaire ou admin
    match /toolbox_journey_index/{indexId} {
      allow read: if isSignedIn()
        && (isAdmin() || resource.data.userId == uid() || resource.data.ownerId == uid());
      allow write: if false;
    }

    // ⛔ [REFUSÉ] Catch-all — tout accès non déclaré est refusé
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
