{
  "schema_version": 1,
  "modules": [
    {
      "id": "authentication",
      "label": "Authentification",
      "patterns": [
        "lib/pages/auth/**",
        "lib/features/auth/**",
        "lib/services/auth_*.dart",
        "lib/services/google_auth_service.dart",
        "lib/services/email_auth_error_mapper.dart",
        "lib/services/account_social_auth_actions.dart"
      ],
      "minimum_percent": 0,
      "minimum_tracked_files_percent": 0,
      "target_percent": 85
    },
    {
      "id": "subscriptions_payment",
      "label": "Abonnements et paiement",
      "patterns": [
        "lib/features/subscriptions/**",
        "lib/pages/**/*subscription*.dart",
        "lib/services/**/*subscription*.dart",
        "lib/services/**/*stripe*.dart",
        "lib/services/**/*payment*.dart"
      ],
      "minimum_percent": 0,
      "minimum_tracked_files_percent": 0,
      "target_percent": 90
    },
    {
      "id": "offer_publication",
      "label": "Publication d'annonces",
      "patterns": [
        "lib/pages/publish_offer_page.dart",
        "lib/pages/publish_offer_widgets.dart",
        "lib/features/offers/presentation/widgets/publish_offer_*.dart",
        "lib/features/publish_ai/**",
        "lib/services/marketplace_publish_service.dart",
        "lib/widgets/ai_publish_control.dart"
      ],
      "minimum_percent": 0,
      "minimum_tracked_files_percent": 0,
      "target_percent": 85
    },
    {
      "id": "messaging",
      "label": "Messagerie",
      "patterns": [
        "lib/pages/messages/**",
        "lib/data/marketplace/chat_repository.dart",
        "lib/services/**/*message*.dart"
      ],
      "minimum_percent": 0,
      "minimum_tracked_files_percent": 0,
      "target_percent": 85
    },
    {
      "id": "administration",
      "label": "Administration",
      "patterns": [
        "lib/admin/**",
        "lib/pages/admin/**",
        "lib/pages/admin_*.dart",
        "lib/services/admin_*.dart"
      ],
      "minimum_percent": 0,
      "minimum_tracked_files_percent": 0,
      "target_percent": 85
    },
    {
      "id": "entrepreneur_journey",
      "label": "Parcours entrepreneur",
      "patterns": [
        "lib/pages/toolbox_*.dart",
        "lib/pages/entrepreneur_*.dart",
        "lib/pages/account/mon_entreprise_parcours_page.dart",
        "lib/services/**/*parcours*.dart",
        "lib/services/toolbox_cache_service.dart"
      ],
      "minimum_percent": 0,
      "minimum_tracked_files_percent": 0,
      "target_percent": 85
    }
  ]
}
