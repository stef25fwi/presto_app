  "updated_at": "2026-08-18",
  "repository_score_target": 10,
  "controls": [
    {
      "id": "data-inventory",
      "title": "Inventaire exhaustif des données",
      "status": "implemented",
      "evidence": ["docs/privacy/STORE_DATA_INVENTORY.md"]
    },
    {
      "id": "google-data-safety",
      "title": "Matrice Google Play Data Safety",
      "status": "implemented",
