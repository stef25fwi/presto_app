rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Upload photos d'offres (utilisé par l'app)
    match /offers/{file} {
      allow write: if request.auth != null;
      allow read: if request.auth != null;
    }

    // Uploads MicroIA: stt/${uid}_${timestamp}.wav / .webm
    match /stt/{file} {
      allow write: if request.auth != null
        && file.matches('^' + request.auth.uid + '_.*\\.(wav|webm)$');

      // Optionnel: restreins davantage si besoin.
      allow read: if request.auth != null
        && file.matches('^' + request.auth.uid + '_.*\\.(wav|webm)$');
    }
  }
}
