rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasAppCheck() {
      return request.app != null;
    }

    function hasClaimRole(role) {
      return isSignedIn()
        && (request.auth.token.roles is list)
        && request.auth.token.roles.hasAny([role]);
    }

    function hasUserDocRole(role) {
      let userPath = /databases/(default)/documents/users/$(request.auth.uid);
      let userData = firestore.get(userPath).data;
      return isSignedIn()
        && firestore.exists(userPath)
        && (
          ((userData.roles is list) && userData.roles.hasAny([role]))
          || userData.primaryRole == role
          || (role == 'moderator' && userData.moderator == true)
          || (role == 'admin' && userData.admin == true)
          || (role == 'superadmin' && userData.superadmin == true)
        );
    }

    function hasAdminDocAccess() {
      let adminPath = /databases/(default)/documents/admins/$(request.auth.uid);
      let adminData = firestore.get(adminPath).data;
      return isSignedIn()
        && firestore.exists(adminPath)
        && adminData.enabled != false;
    }

    function isMarketplaceModerator() {
      return hasClaimRole('moderator')
        || hasUserDocRole('moderator')
        || hasClaimRole('admin')
        || hasUserDocRole('admin')
        || hasClaimRole('superadmin')
        || hasUserDocRole('superadmin')
        || hasAdminDocAccess();
    }

    function isImageUpload() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 15 * 1024 * 1024;
    }

    function isPublicListingMedia(listingId) {
      let listingPath = /databases/(default)/documents/listings/$(listingId);
      return firestore.exists(listingPath)
        && firestore.get(listingPath).data.status == 'active'
        && firestore.get(listingPath).data.visibility == 'public';
    }

    function isConversationParticipant(conversationId) {
      let conversationPath = /databases/(default)/documents/conversations/$(conversationId);
      let conversationData = firestore.get(conversationPath).data;
      return isSignedIn()
        && firestore.exists(conversationPath)
        && (
          ((conversationData.participantIds is list) && conversationData.participantIds.hasAny([request.auth.uid]))
          || ((conversationData.participants is list) && conversationData.participants.hasAny([request.auth.uid]))
          || ((conversationData.participant_ids is list) && conversationData.participant_ids.hasAny([request.auth.uid]))
          || ((conversationData.userIds is list) && conversationData.userIds.hasAny([request.auth.uid]))
          || ((conversationData.memberIds is list) && conversationData.memberIds.hasAny([request.auth.uid]))
        );
    }

    function isMessageAttachmentUpload() {
      return request.resource != null
        && request.resource.size < 20 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('text/.*')
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        );
    }

    // Note: hasAppCheck() retiré (comme pour /stt) car le SDK Flutter web
    // n'attache pas le token App Check aux requêtes Storage (uniquement aux
    // Cloud Callables) : l'exiger ici bloquait l'upload des photos de
    // publication sur le web. Sécurité maintenue par : auth + propriété du
    // chemin (uid) + contentType image + taille max (isImageUpload()).
    match /listingDrafts/{uid}/{draftId}/{fileName} {
      allow write: if isSignedIn() && uid == request.auth.uid && isImageUpload();
      allow read: if isSignedIn() && uid == request.auth.uid;
    }

    match /listings/{uid}/{listingId}/{fileName} {
      allow write: if false;
      allow read: if (hasAppCheck() && isSignedIn() && uid == request.auth.uid)
        || isPublicListingMedia(listingId)
        || isMarketplaceModerator();
    }

    match /messageAttachments/{uid}/{conversationId}/{fileName} {
      allow write: if isSignedIn()
        && uid == request.auth.uid
        && isConversationParticipant(conversationId)
        && isMessageAttachmentUpload();
      allow read: if isConversationParticipant(conversationId) || isMarketplaceModerator();
    }

    // LEGACY RAW MEDIA - READ-ONLY / MIGRATION ONLY.
    match /offers_raw/{uid}/{file} {
      allow write: if false;
      allow read: if hasAppCheck() && request.auth != null && request.auth.uid == uid;
    }

    // LEGACY FINAL MEDIA - READ-ONLY / MIGRATION ONLY.
    match /offers/{uid}/{file} {
      allow write: if false;
      allow read: if hasAppCheck() && ((request.auth != null && request.auth.uid == uid) || isMarketplaceModerator());
    }

    // LEGACY FINAL MEDIA - READ-ONLY / MIGRATION ONLY.
    match /offers/{file} {
      allow write: if false;
      allow read: if hasAppCheck() && isMarketplaceModerator();
    }

    // ✅ [AUTORISÉ] MicroIA STT — upload audio par l'utilisateur
    // Note: hasAppCheck() retiré car le SDK Flutter web n'attache pas le token
    // App Check aux requêtes Storage (uniquement aux Cloud Callables). La sécurité
    // est maintenue par : auth uid + nommage par UID + contentType audio + taille max.
    match /stt/{file} {
      allow write: if request.auth != null
        && file.matches("^" + request.auth.uid + "_.*\\.(wav|webm|m4a|mp4|aac)$")
        && request.resource != null
        && request.resource.contentType.matches('audio/.*|video/webm')
        && request.resource.size < 25 * 1024 * 1024;

      // ℹ️ [INFO] Lecture restreinte au propriétaire
      allow read: if request.auth != null
        && file.matches("^" + request.auth.uid + "_.*\\.(wav|webm|m4a|mp4|aac)$");
    }

    // ✅ [AUTORISÉ] MicroIA Streaming — chunks audio par l'utilisateur
    match /stt_streaming/{uid}/{file} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && file.matches("^[0-9]+_chunk\\.(wav|webm|mp4|aac|m4a)$")
        && request.resource != null
        && request.resource.contentType.matches('audio/.*|video/webm')
        && request.resource.size < 5 * 1024 * 1024;
      allow read: if request.auth != null
        && request.auth.uid == uid;
    }
  }
}
