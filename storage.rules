rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasClaimRole(role) {
      return isSignedIn()
        && (request.auth.token.roles is list)
        && request.auth.token.roles.hasAny([role]);
    }

    function isMarketplaceModerator() {
      return hasClaimRole('moderator')
        || hasClaimRole('admin')
        || hasClaimRole('superadmin');
    }

    function isImageUpload() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 15 * 1024 * 1024;
    }

    function isPublicListingMedia(listingId) {
      let listing = firestore.get(/databases/(default)/documents/listings/$(listingId)).data;
      return listing.status == 'active' && listing.visibility == 'public';
    }

    match /listingDrafts/{uid}/{draftId}/{fileName} {
      allow write: if isSignedIn() && uid == request.auth.uid && isImageUpload();
      allow read: if isSignedIn() && uid == request.auth.uid;
    }

    match /listings/{uid}/{listingId}/{fileName} {
      allow write: if false;
      allow read: if isPublicListingMedia(listingId)
        || (isSignedIn() && uid == request.auth.uid)
        || isMarketplaceModerator();
    }

    // Upload photos d'offres (brutes) : traitement serveur (resize + filigrane)
    match /offers_raw/{uid}/{file} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // Photos d'offres finales (optimisées + filigrane)
    match /offers/{uid}/{file} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null;
    }

    // Upload photos d'offres (utilisé par l'app)
    match /offers/{file} {
      allow write: if false;
      allow read: if request.auth != null;
    }

    // Uploads MicroIA: stt/${uid}_${timestamp}.wav / .webm / .m4a / .mp4
    match /stt/{file} {
      allow write: if request.auth != null
        && file.matches("^" + request.auth.uid + "_.*\\.(wav|webm|m4a|mp4)$");

      // Optionnel: restreins davantage si besoin.
      allow read: if request.auth != null
        && file.matches("^" + request.auth.uid + "_.*\\.(wav|webm|m4a|mp4)$");
    }
  }
}
